# 复制为 .env 后填写。生产环境的值只放在 Vercel 项目设置里，不进代码仓库。

# 数据库：本地开发用 SQLite 文件；线上填 Turso 地址（libsql://xxx.turso.io）和令牌
DATABASE_URI=file:./dev.db
DATABASE_AUTH_TOKEN=

# 后台登录加密密钥（至少 32 位随机字符，可用 openssl rand -hex 32 生成）
PAYLOAD_SECRET=

# 网站正式地址，不带结尾斜杠；本地开发填 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 媒体所用公开 Blob 存储的读写令牌；本地不填时图片存到 ./media 目录
BLOB_READ_WRITE_TOKEN=

# 备份所用私有 Blob 存储的读写令牌和加密密钥（密钥为 64 位十六进制，另在线下保存一份）
BACKUP_BLOB_READ_WRITE_TOKEN=
BACKUP_ENCRYPTION_KEY=

# 邮件发送；本地不填时邮件内容只打印到控制台
RESEND_API_KEY=
# 发件地址，域名需在 Resend 完成认证，例如 Jieke Machinery <noreply@jetcomachinery.com>
MAIL_FROM=

# 定时任务和草稿预览的密钥
CRON_SECRET=
PREVIEW_SECRET=

# 询盘 IP 哈希使用的密钥（不填时用 PAYLOAD_SECRET 派生）
IP_HASH_SECRET=

# Cloudflare Turnstile 人机验证（预留，后台开启后才生效）
TURNSTILE_SECRET_KEY=

# 仅本地调试用：设为 true 时关闭后台双重验证，生产环境不要设置
TOTP_DISABLED=
