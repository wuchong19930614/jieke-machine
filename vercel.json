{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "buildCommand": "npm run build:vercel",
  "crons": [
    { "path": "/api/cron/backup", "schedule": "0 2 * * *" },
    { "path": "/api/cron/backup-media", "schedule": "0 3 * * *" },
    { "path": "/api/cron/retry-notifications", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/cleanup", "schedule": "30 2 * * *" }
  ]
}
